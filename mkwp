# The version of mkwp, shown in the help output. bin/build-release-assets
# writes the released version here in the copy each GitHub release carries; a
# copy taken straight from the repository calls itself unreleased.
readonly mkwp_version='unreleased'

# The patterns that the values of some options must match. The settings in a
# blueprint's site are checked against the pattern of the option with the
# same name.
readonly title_pattern='^[[:print:]]+$'
readonly language_pattern='^[[:lower:]]{2}(_[[:upper:]]{2})?$'
readonly php_pattern='^7\.[0-4]$|^8\.[0-5]$'
readonly wp_pattern='^[0-9]+(\.[0-9]+){0,2}$'

help() {

	echo -e "NAME
	mkwp ${mkwp_version} - make wordpress

\e[1mSYNOPSIS\e[0m
	\e[1mmkwp\e[0m [OPTION]... NAME
	\e[1mmkwp\e[0m \e[1m--destroy\e[0m NAME

\e[1mDESCRIPTION\e[0m
	Makes a local WordPress site with the domain \e[1mname.ddev.site\e[0m where
	\e[1mname\e[0m is the domain name provided as the argument [NAME].

	The site can be described by a blueprint, a JSON file given with
	\e[1m-B\e[0m or \e[1m--blueprint\e[0m. See \e[1mBLUEPRINT\e[0m below.

	If a flag is not specified on the command line, the corresponding
	option is in the first place set to the value in the blueprint, if
	there is one and it has a value for the option, in the second place
	to a value read from the configuration file specified with \e[1m-c\e[0m or
	\e[1m--config\e[0m, in the third place to a value read from the configuration
	file \e[1m~/.mkwp\e[0m, and in the fourth place to a default value.

	If the configuration file \e[1m~/.mkwp\e[0m is missing, an empty one will be
	created.

	A configuration file should be formatted so that each line starting
	with the name of a long format flag, excluding leading double dashes
	(e.g. \e[1memail\e[0m instead of \e[1m--email\e[0m), followed by an equal sign, where the
	corresponding flag has not been specified on the command line, the flag
	is specified with the option set to the value following the equal sign.
	White space may be used around the equal sign.
	Examples:

		title = WordPress Test Site
		php=8.5

\e[1mOPTIONS\e[0m
	\e[1m-t <title>\e[0m
	\e[1m--title=<title>\e[0m
		The title of the WordPress site. If omitted, [NAME] will be
		used.

	\e[1m-d <path>\e[0m
	\e[1m--directory=<path>\e[0m
		The home directory of the website. If omitted, current
		directory will be used as home directory.

	\e[1m-D <dirname>\e[0m
	\e[1m--dirname=<dirname>\e[0m
		The name of the directory the site is created in, underneath the
		home directory. If omitted, [NAME] will be used.

	\e[1m-m <email>\e[0m
	\e[1m--email=<email>\e[0m
		The email address of the first user created in WordPress. If
		omitted, the current username is used as local-part and the
		hostname as domain.

	\e[1m-u <username>\e[0m
	\e[1m--user=<username>\e[0m
		The username of the first user created in WordPress. If
		omitted, the local-part of the email address will be used.

	\e[1m-p <password>\e[0m
	\e[1m--password=<password>\e[0m
		The password of the first user created in WordPress. Must at
		least be 12 characters long. If omitted, a 16 character random
		password is generated.

	\e[1m-l <locale>\e[0m
	\e[1m--language=<locale>\e[0m
		The language of the WordPress site. If omitted, en_US will be
		used. For a number of well-known locales, the site timezone is
		set accordingly (e.g. Europe/Stockholm for sv_SE).

	\e[1m-T <themes>\e[0m
	\e[1m--themes=<themes>\e[0m
		Comma separated list of themes to install. For a theme hosted
		on WordPress.org, enter its slug or URL to its zip-file. For a
		theme hosted in a remote Git repository, enter its remote URL.
		For a theme hosted locally, enter the path to the zip file. The
		last listed theme is activated. If omitted, WordPress's current
		default theme will be used.

	\e[1m-P <plugins>\e[0m
	\e[1m--plugins=<plugins>\e[0m
		Comma separated list of plugins to install. For a plugin hosted
		on WordPress.org, enter its slug or URL to its zip-file. For a
		plugin hosted in a remote Git repository, enter its remote URL.
		For a plugin hosted locally, enter the path to the zip file.

	\e[1m-M <plugins>\e[0m
	\e[1m--mu-plugins=<plugins>\e[0m
		Comma separated list of mu-plugins to install. For each plugin,
		provide the plugin's URL from where it can be downloaded as
		php-file (e.g. https://raw.githubusercontent.com/Kntnt/kntnt-
		adminbar-sanitizer/master/kntnt-adminbar-sanitizer.php).
		If omitted, no mu-plugins will be installed.

	\e[1m-V <version>\e[0m
	\e[1m--php=<version>\e[0m
		Version of PHP to be used. If omitted, PHP 8.5 will be used.

	\e[1m-W <version>\e[0m
	\e[1m--wp=<version>\e[0m
		Version of WordPress to install, given as <major>,
		<major>.<minor> or <major>.<minor>.<patch> (e.g. 6, 6.9 or
		6.9.4). Omitted parts are resolved to the highest available
		release. If omitted entirely, the latest version is installed.
		The core auto-update policy reflects the precision: a full
		<major>.<minor>.<patch> disables auto-updates, while <major> or
		<major>.<minor> enables patch-level updates only.

	\e[1m-R\e[0m
	\e[1m--redis\e[0m
		Adds a Redis service to the site and enables it as WordPress
		object cache backend: the Redis Object Cache plugin is
		installed and activated, and its object-cache.php drop-in is
		enabled. In a configuration file, use \e[1mredis = true\e[0m.

	\e[1m-B <file>\e[0m
	\e[1m--blueprint=<file>\e[0m
		Builds the site that the blueprint <file> describes. See
		\e[1mBLUEPRINT\e[0m below.

	\e[1m--destroy\e[0m
		Destroys the site [NAME]: deletes the DDEV project, including
		its database, and removes the site directory from the file
		system. Asks for confirmation before doing so. All other
		options are ignored.

	\e[1m-c <file>\e[0m
	\e[1m--config=<file>\e[0m
		Reads configuration from a file with the path <file>.
		See description above for details.

	\e[1m-h\e[0m
	\e[1m--help\e[0m
		Display this help and exit.

\e[1mBLUEPRINT\e[0m
	A blueprint is a JSON file that describes a site. Keep it, and the
	files it refers to, in a directory of their own, which can be a Git
	repository and cloned anywhere. mkwp checks the whole blueprint, and
	every file it refers to, before it makes anything. Example:

		{
		  \"\$schema\": \"https://raw.githubusercontent.com/Kntnt/mkwp/main/blueprint.schema.json\",
		  \"note\": \"Our starting point for client sites\",
		  \"site\": { \"title\": \"Client Site\", \"language\": \"sv_SE\", \"php\": \"8.4\", \"redis\": true },
		  \"themes\": [
		    \"twentytwentyfive\",
		    { \"source\": \"./themes/client-child.zip\", \"activate\": true }
		  ],
		  \"plugins\": [
		    { \"source\": \"query-monitor\", \"activate\": true },
		    { \"source\": \"git@github.com:example/private-plugin.git\", \"activate\": true },
		    { \"source\": \"./plugins/commercial-plugin.zip\", \"note\": \"Licensed to us\" }
		  ],
		  \"mu_plugins\": [
		    \"https://raw.githubusercontent.com/Kntnt/kntnt-adminbar-sanitizer/master/kntnt-adminbar-sanitizer.php\"
		  ]
		}

	A blueprint is an object with these keys, all of them optional:

	\e[1m\$schema\e[0m
		The JSON Schema of the blueprint, which lets an editor check
		and complete it. mkwp ignores it.

	\e[1mnote\e[0m
		A note of your own, since JSON has no comments. It may also be
		given in each item of \e[1mthemes\e[0m, \e[1mplugins\e[0m, \e[1mmu_plugins\e[0m and
		\e[1mfiles\e[0m. mkwp ignores it.

	\e[1msite\e[0m
		An object with the settings of the site: \e[1mtitle\e[0m, \e[1mlanguage\e[0m, \e[1mphp\e[0m
		and \e[1mwp\e[0m, which are strings, and \e[1mredis\e[0m, which is true or false.
		Each is checked like the option with the same name, and is
		replaced by the option when it's given on the command line.

	\e[1mthemes\e[0m
	\e[1mplugins\e[0m
		Arrays of the themes and plugins to install. An item is a
		source, as described below, or an object with the source in
		\e[1msource\e[0m, and with \e[1mactivate\e[0m (true or false) and \e[1mnote\e[0m. Each item
		with \"activate\": true is activated, and at most one theme may
		have it. If no theme has it, the last theme is activated.
		Themes and plugins given with \e[1m-T\e[0m and \e[1m-P\e[0m are installed after
		the blueprint's, and the last theme given with \e[1m-T\e[0m is activated
		instead of the blueprint's.

	\e[1mmu_plugins\e[0m
		An array of the mu-plugins to install. An item is the URL of a
		PHP file, or an object with the URL in \e[1msource\e[0m, and with \e[1mnote\e[0m.

	\e[1mfiles\e[0m
		An array of the files and directories to copy into wp-content,
		such as the media that a database refers to. An item is an
		object with a local file or directory in \e[1msource\e[0m, the directory
		to copy it into in \e[1mtarget\e[0m, and \e[1mnote\e[0m. A relative source is
		relative to the blueprint's directory. The target is relative
		to wp-content, as in \"uploads/2024/01\", and is created if it's
		missing. It must not be absolute or start with ~, and its ..
		parts must not lead out of wp-content. A file keeps its name,
		and replaces a file with the same name. A directory's contents
		are merged with what the target already has. Example:

			\"files\": [
			  { \"source\": \"./media\", \"target\": \"uploads\" },
			  { \"source\": \"./fonts/brand.woff2\", \"target\": \"fonts\" }
			]

	\e[1mdatabase\e[0m
		Not supported yet. A blueprint with this key is rejected.

	\e[1mwp_cli\e[0m
		Not supported yet. A blueprint with this key is rejected.

	The source of a theme or plugin is one of these, recognized in this
	order:

		A local path, which starts with ./, ../, / or ~/, to a zip
		file. A relative path is relative to the blueprint's directory.
		The theme or plugin is named after the directory in the zip
		file, so the file's own name doesn't matter.

		A Git repository, whose URL ends with .git. Any URL that Git
		accepts works, including SSH, so a private repository is
		reached with your own SSH setup. The latest tag is checked out,
		or the default branch if there is no tag.

		A URL, which starts with http:// or https://, to a zip file.

		A slug on WordPress.org, which is anything else.

	A site is built in this order:

		- DDEV is configured, with the cron add-on and, if Redis is
		  used, the Redis add-on, and started.
		- WordPress is downloaded and installed.
		- The themes, plugins and mu-plugins are installed.
		- The files are copied into wp-content.
		- The theme to activate, and the plugins with
		  \"activate\": true, are activated.
		- Redis is enabled as object cache, if it is used.
		- The site is opened in the browser.

\e[1mDEPENDENCY\e[0m
	This command requires that a Docker provider is installed and running
	on your system and that DDEV is properly installed and in your path.
	A blueprint also requires jq, and a blueprint with a local zip file
	requires unzip." | less -R

}

# Usage: die <message> <status>
# Echos the <message> and exit with the status code <status>
die() {
	echo -e "\033[0;31m${1:-}\033[0m" 1>&2
	exit "${2:-0}"
}

# Usage: extract_argument <variable> <args>...
# Validates that <args> starts with a short format flag followed by a value
# (e.g. -V 8.3) or a long format flag with an embedded value (e.g. --php=8.3),
# assigns the value to the global variable named <variable>, and sets the
# global variable shift_n to the number of arguments consumed (1 or 2).
extract_argument() {

	if [[ "$2" =~ ^--[^=]+=(.+)$ ]]; then # Long flag format, e.g. --php=8.3

		declare -g "$1"="${BASH_REMATCH[1]}"
		shift_n=1

	elif [[ "$2" =~ ^-[^-]$ && $# -ge 3 ]]; then # Short flag format, e.g. -V 8.3

		declare -g "$1"="$3"
		shift_n=2

	else

		die "Error: Missing option for $2" 12

	fi

}

# Usage: handle_arguments <args>...
# Parses <args>, which is expected to be the argument list from the command
# line, and creates corresponding variables containing options.
handle_arguments() {

	while [[ $# -gt 0 ]]; do
		case $1 in
			-h | --help) help; die ;;
			-t | --title=*) extract_argument title "$@"; shift $shift_n ;;
			-d | --directory=*) extract_argument directory "$@"; shift $shift_n ;;
			-D | --dirname=*) extract_argument dirname "$@"; shift $shift_n ;;
			-m | --email=*) extract_argument email "$@"; shift $shift_n ;;
			-u | --user=*) extract_argument user "$@"; shift $shift_n ;;
			-p | --password=*) extract_argument password "$@"; shift $shift_n ;;
			-l | --language=*) extract_argument language "$@"; shift $shift_n ;;
			-T | --themes=*) extract_argument themes "$@"; shift $shift_n ;;
			-P | --plugins=*) extract_argument plugins "$@"; shift $shift_n ;;
			-M | --mu-plugins=*) extract_argument mu_plugins "$@"; shift $shift_n ;;
			-V | --php=*) extract_argument php "$@"; shift $shift_n ;;
			-W | --wp=*) extract_argument wp "$@"; shift $shift_n ;;
			-R | --redis) redis=true; shift ;;
			-B | --blueprint=*) extract_argument blueprint "$@"; shift $shift_n ;;
			--destroy) destroy=true; shift ;;
			-c | --config=*) extract_argument config "$@"; shift $shift_n ;;
			*) if [[ -z "$name" ]]; then name="$1"; shift; else die "Error: Invalid flag: $1" 2; fi ;;
		esac
	done

	[[ -n "$name" ]] || die "The required argument NAME is missing. See \033[1mmkwp -h\033[22m for more information." 5

}

# Usage: handle_config_files
# Reads options from the configuration file given with -c/--config, if any,
# and from ~/.mkwp, without overriding options already set on the command line.
handle_config_files() {

	# Create a list of files to read configuration from
	local files=()

	# Add config file to the list of configuration files if it exists and is readable
	if [[ $config ]]; then

		# Use /dev/stdin if config file is -
		if [[ "$config" == "-" ]]; then
			config="/dev/stdin"
		fi

		# Validate config file
		[[ -r $config ]] || die "Invalid path to config file" 10

		# Add the config file to the list of files to read configuration from
		files+=("$config")

	fi

	# Add ~/.mkwp file to the list of configuration files. Create ~/.mkwp if it doesn't exist.
	if [[ ! -e ~/.mkwp ]]; then
		touch ~/.mkwp || die "Couldn't create ~/.mkwp" 12
	fi
	[[ -r ~/.mkwp ]] || die "Couldn't read ~/.mkwp" 12
	files+=(~/.mkwp)

	# Read config files
	while IFS= read -r line || [[ "$line" ]]; do

		# Validate the line structure
		if [[ $line =~ ^(name|title|directory|dirname|email|user|password|language|themes|plugins|mu-plugins|php|wp|redis)[[:space:]]*=[[:space:]]*(.*) ]]; then

			# Extract keyword and value
			local key="${BASH_REMATCH[1]//-/_}"
			local value="${BASH_REMATCH[2]}"

			# If the global variable named in $key is empty, assign it the
			# value in $value. N.B. We know that $key contains a name of
			# an already declared global variable, since all variables names
			# in the regex above are declared before this function is called.
			if [[ -z ${!key} ]]; then
				eval "$key=$(printf "%q" "$value")"
			fi

		fi

	done < <(cat "${files[@]}")

}

# Usage: handle_blueprint
# Reads the blueprint given with -B/--blueprint. All of it is checked before
# mkwp checks Docker and DDEV, so that a mistake in it never leaves a
# half-built site behind.
handle_blueprint() {

	# jq reads the blueprint, and is needed only when there is one
	command -v jq > /dev/null || die "mkwp needs jq to read a blueprint. Install jq and try again." 27

	# The blueprint must be a file that can be read
	[[ -f $blueprint && -r $blueprint ]] || die "Couldn't read the blueprint $blueprint" 28

	# Check the blueprint's structure before anything is read from it
	check_blueprint

	# Relative paths in the blueprint are relative to its own directory
	blueprint_dir=$(cd "$(dirname "$blueprint")" && pwd -P)

	# Read each key the blueprint has with the function named read_blueprint_
	# followed by the key, if there is one. Keys such as note need no reading.
	local key
	local -a keys
	read_blueprint keys 'keys_unsorted[]'
	for key in "${keys[@]}"; do
		if declare -F "read_blueprint_$key" > /dev/null; then
			"read_blueprint_$key"
		fi
	done

}

# Usage: check_blueprint
# Checks that the blueprint is one JSON object, with only the keys the
# blueprint format has, and with values of the types the format gives them.
check_blueprint() {

	# jq accepts an empty file, and a file with several JSON values, as a
	# stream of values, so count them.
	local count
	count=$(jq -s length < "$blueprint" 2>&1) || die "Invalid JSON in the blueprint $blueprint: ${count#jq: parse error: }" 29
	(( count == 1 )) || die "Invalid JSON in the blueprint $blueprint: it must hold one JSON object, but holds $count values" 29

	# The jq program that checks the blueprint against its format. It prints
	# the first error it finds, if any, preceded by the exit status for that
	# kind of error and a space.
	local program
	IFS= read -r -d '' program <<- 'JQ' || true

	# Usage: location
	# The place of a value in the blueprint, given its path, written the way
	# jq writes it, e.g. .themes[2].source.
	def location:
		if length == 0 then "the top level"
		else map(
			if type == "number" then "[\(.)]"
			elif test("^[A-Za-z_][A-Za-z0-9_]*$") then ".\(.)"
			else ".[\(tojson)]" end
		) | join("") end;

	# Usage: with_article
	# The name of a JSON type with its indefinite article, e.g. an object.
	def with_article:
		if . == "null" then . elif test("^[aeiou]") then "an \(.)" else "a \(.)" end;

	# Usage: check(schema; path)
	# Emits an error for each way the value breaks schema, where path is the
	# value's path in the blueprint. A schema is an object with the JSON type
	# or types the value may have, under type, the keys an object may have,
	# under props, the keys it must have, under required, and the schema of
	# the items in an array, under items. A key whose schema is null is not a
	# known key.
	def check($schema; $path):
		type as $type
		| ([$schema.type] | flatten) as $types
		| if $schema == null then
			"30 \($path | location) is not a known key"
		elif $types | any(. == $type) | not then
			"31 \($path | location) must be \($types | map(with_article) | join(" or ")), not \($type | with_article)"
		elif $type == "string" and (explode | any(. == 0)) then
			"31 \($path | location) must not contain a NUL character"
		elif $type == "object" then
			( ($schema.required // [])[] as $key | select(has($key) | not)
				| "32 \($path | location) has no \"\($key)\"" ),
			( to_entries[] | .key as $key | .value | check($schema.props[$key]; $path + [$key]) )
		elif $type == "array" then
			to_entries[] | .key as $index | .value | check($schema.items; $path + [$index])
		else
			empty
		end;

	# The parts of the blueprint format, from the inside out.
	def string: {type: "string"};
	def boolean: {type: "boolean"};
	def note: string;

	# site: the settings of the site.
	def site: {type: "object", props: {
		title: string,
		language: string,
		php: string,
		wp: string,
		redis: boolean
	}};

	# themes and plugins: each item is a source, or an object with one.
	def item: {type: ["string", "object"], required: ["source"], props: {
		source: string,
		activate: boolean,
		note: note
	}};

	# mu_plugins: each item is a source, or an object with one.
	def mu_plugin: {type: ["string", "object"], required: ["source"], props: {
		source: string,
		note: note
	}};

	# files: each item is a local file or directory to copy, and the
	# directory underneath wp-content to copy it into.
	def files: {type: "array", items: {type: "object", required: ["source", "target"], props: {
		source: string,
		target: string,
		note: note
	}}};

	# database: not supported yet, so rejected as an unknown key.
	def database: null;

	# wp_cli: not supported yet, so rejected as an unknown key.
	def wp_cli: null;

	# The blueprint itself.
	def blueprint: {type: "object", props: {
		"$schema": string,
		note: note,
		site: site,
		themes: {type: "array", items: item},
		plugins: {type: "array", items: item},
		mu_plugins: {type: "array", items: mu_plugin},
		files: files,
		database: database,
		wp_cli: wp_cli
	}};

	first(check(blueprint; []))
	JQ

	local error
	error=$(jq -r "$program" < "$blueprint" 2>&1) || die "Couldn't check the blueprint $blueprint: $error" 29
	[[ -z $error ]] || die "Invalid blueprint $blueprint: ${error#* }" "${error%% *}"

}

# Usage: read_blueprint <array> <filter>
# Sets the array named <array> to the values that the jq <filter> yields from
# the blueprint, as strings. The values are separated by NUL characters, which
# check_blueprint has made sure that no string in the blueprint has.
read_blueprint() {

	local -n values=$1
	# shellcheck disable=SC2034 # The array is used by its name
	mapfile -d '' values < <(jq -j "($2) | tostring + \"\\u0000\"" < "$blueprint")
	wait $!

}

# Usage: read_blueprint_site
# Reads the site settings in the blueprint. Each is checked against the
# pattern of the option with the same name, and is used unless the option is
# given on the command line.
read_blueprint_site() {

	local -a settings
	read_blueprint settings '.site | to_entries[] | .key, .value'

	local i key value pattern what
	for (( i = 0; i < ${#settings[@]}; i += 2 )); do

		key=${settings[i]}
		value=${settings[i + 1]}

		case $key in
			title)    pattern=$title_pattern what='title' ;;
			language) pattern=$language_pattern what='language code' ;;
			php)      pattern=$php_pattern what='PHP version' ;;
			wp)       pattern=$wp_pattern what='WordPress version' ;;
			redis)    pattern='^(true|false)$' what='setting for Redis' ;;
		esac
		[[ $value =~ $pattern ]] || die "Invalid blueprint $blueprint: \"$value\" in .site.$key is not a valid $what" 33

		# An option given on the command line takes precedence
		if [[ -z ${!key} ]]; then
			printf -v "$key" '%s' "$value"
		fi

	done

}

# Usage: read_blueprint_themes
# Reads the themes in the blueprint. The theme marked with "activate": true is
# the one to activate, or, if none is marked, the last one.
read_blueprint_themes() {

	local -a indices
	read_blueprint indices '.themes | keys[]'

	local i marked=
	for i in "${indices[@]}"; do
		read_blueprint_item themes "$i"
		if [[ $item_activate == true ]]; then
			[[ -z $marked ]] || die "Invalid blueprint $blueprint: .themes has more than one theme with \"activate\": true" 36
			marked=$item_name
		fi

		# Activate the marked theme, or the last one read so far
		theme=${marked:-$item_name}

	done

}

# Usage: read_blueprint_plugins
# Reads the plugins in the blueprint, and notes those marked with
# "activate": true for activation.
read_blueprint_plugins() {

	local -a indices
	read_blueprint indices '.plugins | keys[]'

	local i
	for i in "${indices[@]}"; do
		read_blueprint_item plugins "$i"
		if [[ $item_activate == true ]]; then
			plugins_to_activate+=("$item_name")
		fi
	done

}

# Usage: read_blueprint_mu_plugins
# Reads the mu-plugins in the blueprint.
read_blueprint_mu_plugins() {

	local -a indices
	read_blueprint indices '.mu_plugins | keys[]'

	local i
	for i in "${indices[@]}"; do
		read_blueprint_item mu_plugins "$i"
	done

}

# Usage: read_blueprint_item <list> <index>
# Reads item number <index> in the blueprint's <list>, which is themes, plugins
# or mu_plugins, checks its source, and adds it to <list>. Sets the global
# variable item_name to the name the theme or plugin is activated by, and the
# global variable item_activate to true if the item is marked with
# "activate": true.
read_blueprint_item() {

	local list=$1
	local where=".$1[$2]"

	# An item is a source, or an object with a source
	local -a fields
	read_blueprint fields "$where | if type == \"string\" then {source: .} else . end | .source, .activate == true"
	local source=${fields[0]}
	item_activate=${fields[1]}
	item_name=

	local kind path
	kind=$(source_kind "$source")

	case $list:$kind in

		# An mu-plugin is a PHP file, downloaded from a URL
		mu_plugins:*)
			[[ $kind == url && $source == *.php ]] || die "Invalid blueprint $blueprint: \"$source\" in $where is not the URL of a PHP file" 34
			;;

		# A local theme or plugin is a zip file, and is named after the
		# directory it unpacks into
		*:local)
			path=$(blueprint_path "$source")
			[[ -e $path ]] || die "Invalid blueprint $blueprint: \"$source\" in $where doesn't exist" 35
			[[ ! -d $path ]] || die "Invalid blueprint $blueprint: \"$source\" in $where is a directory, not a zip file" 35
			[[ -r $path ]] || die "Invalid blueprint $blueprint: \"$source\" in $where can't be read" 35
			command -v unzip > /dev/null || die "mkwp needs unzip to read \"$source\" in the blueprint $blueprint. Install unzip and try again." 27
			item_name=$(zip_name "$path") || die "Invalid blueprint $blueprint: \"$source\" in $where is not a zip file" 35
			source=$path
			;;

		# A theme or plugin from a Git repository or a URL is named after
		# the last part of the source
		*:git | *:url)
			item_name=$(source_name "$source")
			;;

		# Anything else is a slug on WordPress.org, which is also the name
		*:slug)
			[[ $source =~ ^[[:lower:][:digit:]_-]+$ ]] || die "Invalid blueprint $blueprint: \"$source\" in $where is not a WordPress.org slug. A local path must start with ./, ../, / or ~/." 34
			item_name=$source
			;;

	esac

	add_item "$list" "$kind" "$source"

}

# Usage: source_kind <source>
# Echoes what the theme, plugin or mu-plugin source <source> in a blueprint is,
# tried in this order: a local path (local), a Git repository (git), a URL
# (url) or a slug on WordPress.org (slug).
source_kind() {

	# shellcheck disable=SC2088 # A literal ~/ is meant
	case $1 in
		./* | ../* | /* | '~/'*) echo local ;;
		*.git)                   echo git ;;
		http://* | https://*)    echo url ;;
		*)                       echo slug ;;
	esac

}

# Usage: blueprint_path <path>
# Echoes the local path <path> from the blueprint as a path that works from any
# directory: ~/ is the home directory, and a relative path is relative to the
# blueprint's directory.
blueprint_path() {

	# shellcheck disable=SC2088 # A literal ~/ is meant
	case $1 in
		/*)    echo "$1" ;;
		'~/'*) echo "$HOME/${1#'~/'}" ;;
		*)     echo "$blueprint_dir/$1" ;;
	esac

}

# Usage: add_item <list> <kind> <source>
# Adds a theme, plugin or mu-plugin to <list>, which is themes, plugins or
# mu_plugins, unless <list> already has <source>. <kind> says how it's fetched
# from <source>: as a local zip file (local), from a Git repository (git), from
# a URL (url) or from WordPress.org (slug). <list> is kept in two arrays with
# the same indices, <list>_sources and <list>_kinds.
add_item() {

	local -n sources=${1}_sources kinds=${1}_kinds
	local existing

	for existing in "${sources[@]}"; do
		[[ $existing != "$3" ]] || return 0
	done

	sources+=("$3")
	kinds+=("$2")

}

# Usage: add_option_items <list> <items>
# Adds the comma-separated <items>, given with -T, -P or -M, to <list>, which is
# themes, plugins or mu_plugins. An item is fetched by the rules these options
# have always had: from a Git repository if it ends with .git, as a local zip
# file if there is such a file, from a URL if it starts with http:// or
# https://, and from WordPress.org otherwise. A relative path is relative to
# the current directory.
add_option_items() {

	local list=$1 item kind
	local -a items=()
	IFS=',' read -r -a items <<< "$2"

	for item in "${items[@]}"; do

		if [[ -e $item && $item != /* ]]; then
			item=$PWD/$item
		fi

		if [[ $item == *.git ]]; then
			kind=git
		elif [[ -f $item ]]; then
			kind=local
		elif [[ $item == http://* || $item == https://* ]]; then
			kind=url
		else
			kind=slug
		fi

		add_item "$list" "$kind" "$item"

	done

}

# Usage: theme_to_activate <theme-list>
# Echo the slug of the last theme in the list of themes <theme-list>.
theme_to_activate() {
	source_name "${1##*,}"
}

# Usage: source_name <source>
# Echoes the name of a theme or plugin from <source>, which is the last part of
# its path or URL, without its suffix.
source_name() {

	(

		# Enable the extended pattern matching
		shopt -s extglob

		# Echo the basename without the suffix
		echo "${1//+(*\/|.*)}"

	)

}

# Usage: zip_name <zip-file>
# Echoes the name of the directory that the theme or plugin in <zip-file>
# unpacks into, which is the top directory of the first entry in the file.
# Fails if <zip-file> is not a zip file.
zip_name() {

	local entries
	entries=$(unzip -Z1 "$1" 2> /dev/null) || return 1
	entries=${entries%%$'\n'*}
	echo "${entries%%/*}"

}

# Usage: download_latest_tag <remote-git-repository-url>
# Clones <remote-git-repository-url> and checkout the latest tag.
# The local repository created in the process is removed. The argument
# <remote-git-repository-url> must be the URL to a remote repository.
# Example: https://github.com/Kntnt/kntnt-canvas.git
# Example: git@github.com:Kntnt/kntnt-canvas.git
download_latest_tag() {

	(

		# Enable Bash extended globbing features
		shopt -s extglob

		# Store the first argument of the function in 'repo', which should be the repository URL
		local repo=$1

		# Extract the repository name from the URL for use as the directory name
		local name
		name=$(source_name "$repo")

		# The label of the tag or branch to be checked out
		local checkout=

		# Create a new directory named after the repository and change into it
		mkdir -p "$name"
		cd "$name"

		# Initialize a new Git repository and add a remote pointing to the original repository
		git init
		git remote add origin "$repo"

		# Fetch all tags from the remote repository, cleaning up any deleted references
		git fetch --prune --tags

		# Attempt to identify the latest tag in the remote repository
		local tag
		tag=$(git rev-list --tags --max-count=1)

		# If a tag is found, convert the tag hash to its name and checkout the tag
		if [[ -n $tag ]]; then

			# Convert the latest tag hash to the tag name
			checkout=$(git describe --tags "$tag")

			echo "Checking out tag: $checkout"

		# If no tags are found, try to find and checkout the default branch
		else

			# Fetch the name of the default branch from the remote repository, ensuring output in English
			local default_branch
			default_branch=$(LC_ALL=C git remote show origin | sed -n '/HEAD branch/s/.*: //p')

			# Fetch the latest state of the default branch and switch to it in a detached HEAD state
			git fetch origin "$default_branch"

			checkout="origin/$default_branch"

			echo "No tags found, attempting to check out the default branch: $default_branch"

		fi

		# Checkout the code
		git checkout "$checkout"

		# Remove the .git directory to clean up repository metadata from the local filesystem
		rm -rf .git

	)

}


# Usage: wp_install_zip <type> <path>
# Installs a local zip file with the path <path> as a theme or plugin, where
# <type> is `theme` or `plugin`. The file is temporarily copied into the
# project so that WP-CLI inside the container can reach it.
wp_install_zip() {

	local type="$1"
	local item="$2"

	# Temporarily copy the zip-file into the project and flush Mutagen so the
	# copy is visible inside the container.
	mkdir -p "$wp_path/.mkwp"
	cp "$item" "$wp_path/.mkwp/"
	item=".mkwp/$(basename "$item")"
	ddev mutagen sync

	# Install and remove the temporary copy.
	ddev wp "$type" install "$item"
	ddev exec rm -rf .mkwp

}

# Usage: install_items <list>
# Installs the themes, plugins or mu-plugins in <list>, which is themes, plugins
# or mu_plugins, into the directory with the same name underneath wp-content.
# See add_item.
install_items() {

	(

		# shellcheck disable=SC2178 # The arrays are used by their names
		local -n sources=${1}_sources kinds=${1}_kinds
		local dir=${1//_/-} # mu_plugins are installed in mu-plugins
		local type=${dir%s}
		local -a batch=()
		local i

		cd "$wp_path/wp-content/$dir"

		# Handle items that need special treatment one by one, and collect
		# plain slugs and zip URLs for a single batched WP-CLI install.
		for i in "${!sources[@]}"; do
			case ${kinds[i]} in
				local) wp_install_zip "$type" "${sources[i]}" ;;
				git)   download_latest_tag "${sources[i]}" ;;
				url)   if [[ ${sources[i]} == *.php ]]; then curl -OLf "${sources[i]}"; else batch+=("${sources[i]}"); fi ;;
				slug)  batch+=("${sources[i]}") ;;
			esac
		done

		# Install all collected slugs and URLs in one WP-CLI call
		if (( ${#batch[@]} )); then
			ddev wp "$type" install "${batch[@]}"
		fi

	)

}

# Usage: read_blueprint_files
# Reads the files in the blueprint, and checks that each source exists and can
# be read, and that each target is a directory underneath wp-content. Adds
# them to copy_sources and copy_targets. See copy_files.
read_blueprint_files() {

	local -a entries
	read_blueprint entries '.files[] | .source, .target'

	local i source target source_path target_path where
	for (( i = 0; i < ${#entries[@]}; i += 2 )); do

		source=${entries[i]}
		target=${entries[i + 1]}
		where=".files[$(( i / 2 ))]"

		source_path=$(blueprint_path "$source")
		[[ $source && -e $source_path ]] || die "Invalid blueprint $blueprint: \"$source\" in $where.source doesn't exist" 35
		[[ -r $source_path ]] || die "Invalid blueprint $blueprint: \"$source\" in $where.source can't be read" 35

		# shellcheck disable=SC2088 # A literal ~ is meant
		[[ $target && $target != /* && $target != '~'* ]] || die "Invalid blueprint $blueprint: \"$target\" in $where.target is not a path relative to wp-content" 37
		target_path=$(wp_content_path "$target") || die "Invalid blueprint $blueprint: \"$target\" in $where.target is outside wp-content" 38

		copy_sources+=("$source_path")
		copy_targets+=("$target_path")

	done

}

# Usage: wp_content_path <path>
# Echoes the relative <path> without empty parts and . parts, and with each ..
# part taking away the part before it, or nothing if that leaves no part, which
# is wp-content itself. Fails if a .. part leads out of wp-content. The path is
# only read, not looked up, so a symbolic link in it is not followed.
wp_content_path() {

	local rest=$1 part
	local -a parts=()

	while [[ $rest ]]; do
		part=${rest%%/*}
		if [[ $rest == */* ]]; then rest=${rest#*/}; else rest=; fi
		case $part in
			'' | .) ;;
			..) (( ${#parts[@]} )) || return 1; unset 'parts[-1]' ;;
			*)  parts+=("$part") ;;
		esac
	done

	local IFS=/
	echo "${parts[*]}"

}

# Usage: copy_files
# Copies each file in copy_sources into the directory with the same index in
# copy_targets, which is relative to wp-content and is created if it's missing,
# and merges the contents of each directory into it. A file with the same name
# is replaced. Mutagen is flushed afterwards, so that the copies are visible
# inside the container to the next WP-CLI step. Only uploads is mounted into
# the container directly.
copy_files() {

	local i target
	for i in "${!copy_sources[@]}"; do
		target="$wp_path/wp-content/${copy_targets[i]}"
		mkdir -p "$target"
		if [[ -d ${copy_sources[i]} ]]; then
			cp -R "${copy_sources[i]}/." "$target/"
		else
			cp "${copy_sources[i]}" "$target/"
		fi
	done

	ddev mutagen sync

}

# Usage: resolve_wp_version <version>
# Resolves a possibly-partial WordPress version (e.g. 6, 6.9 or 6.9.4) to the
# highest released version that matches, by querying the WordPress.org API.
# Echoes the resolved version, or aborts if the fetch fails or nothing matches.
resolve_wp_version() {

	# Turn the requested version into a boundary-aware pattern so that, for
	# example, 6 matches 6.9.4 but not 16, and 6.9 matches 6.9.4 but not 6.90.
	local prefix="${1//./\\.}"

	# Fetch the list of released versions from wordpress.org
	local versions
	versions=$(curl -sf https://api.wordpress.org/core/stable-check/1.0/) || die "Couldn't fetch the list of WordPress versions from wordpress.org" 18

	# Keep the released versions matching the prefix and pick the highest one
	local resolved
	resolved=$(grep -oE '"[0-9]+\.[0-9]+(\.[0-9]+)?"' <<< "$versions" | tr -d '"' | grep -E "^${prefix}(\.|\$)" | sort -V | tail -1 || true)
	[[ "$resolved" ]] || die "No released WordPress version matches: $1" 19

	echo "$resolved"

}

