# Usage: read_blueprint_database
# Reads the database in the blueprint: the dump to import, which must be plain
# or gzip-compressed SQL, or the DDEV snapshot to restore, and the database
# server to import or restore it into, which a snapshot must have. DDEV takes
# any file whose name ends in .gz for compressed SQL, and imports a file it
# can't decompress as it is, so the name of a dump must end in .sql or .sql.gz.
# DDEV reads the server a snapshot was taken from in the end of its name, and
# restores it only into that server, so the name must have it, and it must be
# the given server. Which versions of a server DDEV has depends on the version
# of DDEV, so only the form of the server is checked here, and DDEV checks the
# version.
read_blueprint_database() {

	# The key is dump or snapshot, since the blueprint has exactly one of them
	local -a fields
	read_blueprint fields '.database | (if has("dump") then "dump" else "snapshot" end), (.dump // .snapshot), (.server | values)'
	local key=${fields[0]} file=${fields[1]} server=${fields[2]-}

	if (( ${#fields[@]} > 2 )); then
		[[ $server =~ ^(mariadb|mysql):[0-9]+\.[0-9]+$ ]] || die "Invalid blueprint $blueprint: \"$server\" in .database.server is not a MariaDB or MySQL server, given as mariadb:<version> or mysql:<version>" 46
		database_server=$server
	fi

	local path what
	path=$(blueprint_path "$file")
	case $key in
		dump) what='.sql or .sql.gz file' ;;
		snapshot) what='DDEV snapshot' ;;
	esac
	[[ -e $path ]] || die "Invalid blueprint $blueprint: \"$file\" in .database.$key doesn't exist" 35
	[[ ! -d $path ]] || die "Invalid blueprint $blueprint: \"$file\" in .database.$key is a directory, not a $what" 35
	[[ -r $path ]] || die "Invalid blueprint $blueprint: \"$file\" in .database.$key can't be read" 35

	# Keep the path without parts such as ./, since messages show it
	path=$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")

	case $key in
		dump)
			[[ $path == *.sql || $path == *.sql.gz ]] || die "Invalid blueprint $blueprint: \"$file\" in .database.dump is not a .sql or .sql.gz file" 35
			database_dump=$path
			;;
		snapshot)
			[[ ${path##*/} =~ (mariadb|mysql|postgres)_([0-9.]+)\.(zst|gz|mbstream|xbstream)$ ]] || die "Invalid blueprint $blueprint: \"$file\" in .database.snapshot is not a DDEV snapshot, whose name ends with the server it was taken from, as in site-mariadb_11.8.zst" 35
			local taken_from=${BASH_REMATCH[1]}:${BASH_REMATCH[2]}
			[[ $taken_from == "$server" ]] || die "Invalid blueprint $blueprint: \"$file\" in .database.snapshot was taken from $taken_from, not from $server in .database.server. A snapshot can only be restored into the server it was taken from." 50
			database_snapshot=$path
			;;
	esac

}

# Usage: restore_snapshot
# Restores the DDEV snapshot in database_snapshot into the site's database
# server. DDEV mounts the directory of a snapshot outside the project into the
# database container, which only works for a directory that Docker shares, so
# the snapshot is copied into the project's own snapshot directory. It keeps
# its name, from which DDEV reads the server it was taken from. The copy is
# removed afterwards, since restoring it again would bring back the old site's
# address.
restore_snapshot() {

	local copy
	copy="$wp_path/.ddev/db_snapshots/${database_snapshot##*/}"
	mkdir -p "$wp_path/.ddev/db_snapshots"
	cp "$database_snapshot" "$copy"
	ddev snapshot restore "$copy"
	rm "$copy"

}

# Usage: adopt_database <source>
# Makes the database that was just imported from <source>, which only names it
# in messages, the site's own. It must be a WordPress site with the table
# prefix wp_. Its old address is replaced by the site's, the database is
# upgraded to the version of WordPress that was installed, mkwp's user is made
# an administrator with the given email address and password, the site
# settings that were given explicitly are applied, and the caches are flushed.
# All other users, and all settings that were not given explicitly, are kept.
# WP-CLI runs without plugins and themes where it can, so that one in the
# database that fails under WP-CLI can't stop it.
adopt_database() {

	local source=$1

	ddev wp core is-installed --skip-plugins --skip-themes &> /dev/null || die "The database from $source is not a WordPress site with the table prefix wp_, which is the only prefix mkwp supports." 47

	# Replace the old address, which is in home and siteurl. They differ if
	# WordPress was in a subdirectory of the old site, and then the shorter is
	# part of the longer. The longer is replaced first, so that the
	# subdirectory goes with it, since WordPress is in the site's root here.
	local home siteurl longer shorter
	home=$(wp_value option get home)
	siteurl=$(wp_value option get siteurl)
	if (( ${#siteurl} >= ${#home} )); then
		longer=${siteurl%/} shorter=${home%/}
	else
		longer=${home%/} shorter=${siteurl%/}
	fi
	replace_address "$longer"
	if [[ $shorter != "$longer" ]]; then
		replace_address "$shorter"
	fi

	ddev wp core update-db --skip-plugins --skip-themes

	adopt_user "$source"

	# Apply the site settings that were given explicitly. The settings mkwp
	# gives a new site by default, such as a title made from NAME, are not.
	if [[ $title_given ]]; then
		ddev wp option update blogname "$title" --skip-plugins --skip-themes
	fi
	if [[ $language_given ]]; then
		ddev wp site switch-language "$language" --skip-plugins --skip-themes
	fi

	# Flush the rewrite rules with plugins and themes, since they add rules
	ddev wp rewrite flush
	ddev wp cache flush --skip-plugins --skip-themes

}

# Usage: replace_address <old>
# Replaces the address <old> with the site's address throughout the database,
# both as plain text and JSON-escaped, as in https:\/\/example.com, unless it
# already is the site's address.
replace_address() {

	[[ $1 != "$url" ]] || return 0

	ddev wp search-replace "$1" "$url" --all-tables --precise --report-changed-only --skip-plugins --skip-themes
	ddev wp search-replace "${1//\//\\/}" "${url//\//\\/}" --all-tables --precise --report-changed-only --skip-plugins --skip-themes

}

# Usage: adopt_user <source>
# Makes mkwp's user an administrator with the given email address and
# password, in the database just imported from <source>, which only names it
# in messages. The user is updated if the database has it, and created
# otherwise. Stops if the email address belongs to another user, since two
# users can't have the same email address.
adopt_user() {

	local id owner
	id=$(wp_value user list --login="$user" --field=ID)
	owner=$(wp_value user list --search="$email" --field=ID)

	if [[ $owner && $owner != "$id" ]]; then
		owner=$(wp_value user get "$owner" --field=user_login)
		die "The email address $email belongs to the user $owner in the database from $1, so it can't be given to $user. Give $user another email address, or use $owner." 48
	fi

	if [[ $id ]]; then
		ddev wp user update "$id" --user_email="$email" --user_pass="$password" --role=administrator --skip-email --skip-plugins --skip-themes
	else
		ddev wp user create "$user" "$email" --role=administrator --user_pass="$password" --skip-plugins --skip-themes
	fi

}

# Usage: wp_value <arg>...
# Echoes what `ddev wp <arg>...` prints, run without plugins and themes, as a
# value to use. Under PHP 8.5, WP-CLI prints deprecation notices ahead of what
# it was asked for, each after an empty line, so empty lines and such notices
# are left out.
wp_value() {
	ddev wp "$@" --skip-plugins --skip-themes 2> /dev/null | sed -e '/^Deprecated: .* on line [0-9]*$/d' -e '/^$/d'
}

# Usage: read_blueprint_wp_cli
# Reads the WP-CLI commands in the blueprint. Bash has no arrays of arrays, so
# the arguments of all the commands are kept one after another in
# wp_cli_args, and the number of arguments of each command in wp_cli_lengths.
read_blueprint_wp_cli() {
	read_blueprint wp_cli_args '.wp_cli[][]'
	read_blueprint wp_cli_lengths '.wp_cli[] | length'
}

# Usage: run_wp_cli_commands
# Runs the WP-CLI commands from the blueprint in order, and stops mkwp at the
# first that fails, with a message that shows the command quoted as a shell
# would need it. `ddev wp` passes its arguments to WP-CLI without a shell, so
# each reaches WP-CLI exactly as written. A command gets no input, so one that
# asks for confirmation can't make the build wait for an answer.
run_wp_cli_commands() {

	local i offset=0 shown
	local -a command

	for i in "${!wp_cli_lengths[@]}"; do
		command=("${wp_cli_args[@]:offset:wp_cli_lengths[i]}")
		offset=$(( offset + wp_cli_lengths[i] ))
		printf -v shown ' %q' "${command[@]}"
		ddev wp "${command[@]}" < /dev/null || die "The WP-CLI command .wp_cli[$i] in the blueprint $blueprint failed with exit status $?: wp$shown" 40
	done

}

# Usage: destroy_site
# Deletes the DDEV project named $name, including its database, and removes
# the site directory from the file system. Asks for confirmation first.
destroy_site() {

	# Look up the project's root directory in DDEV's project registry. Keep
	# stdin away from ddev, which otherwise consumes the confirmation input
	# below when it is piped to the script.
	local json approot
	json=$(ddev describe "$name" -j 2> /dev/null < /dev/null) || die "No DDEV project named '$name' was found." 21
	[[ $json =~ \"approot\":\"([^\"]+)\" ]] || die "Couldn't determine the directory of the project '$name'." 22
	approot="${BASH_REMATCH[1]}"

	# Require the user to retype the project name before destroying anything
	echo -e "This will delete the DDEV project \e[1m$name\e[0m and remove the directory \e[1m$approot\e[0m."
	local confirmation
	read -r -p "Type the project name to confirm: " confirmation
	[[ "$confirmation" == "$name" ]] || die "Aborted." 23

	# Delete the DDEV project without keeping a snapshot, and remove the files
	ddev delete --omit-snapshot --yes "$name"
	rm -rf "$approot"

	echo "The site '$name' has been destroyed."
	exit 0

}

# =============================================================================


# If MKWP_DEBUG is defined, print a trace of simple commands, for commands,
# case commands, select commands, and arithmetic for commands and their
# arguments or associated word lists after they are expanded and before they
# are executed. The value of the PS4 variable is expanded and the resultant
# value is printed before the command and its expanded arguments.
[[ ${MKWP_DEBUG:-} ]] && set -x || MKWP_DEBUG=

# The return value of a pipeline is the value of the last (rightmost) command
# to exit with a non-zero status, or zero if all commands in the pipeline exit
# successfully.
set -o pipefail

# Treat unset variables and parameters other than the special parameters ‘@’ or
# ‘*’, or array variables subscripted with ‘@’ or ‘*’, as an error when
# performing parameter expansion. An error message will be written to the
# standard error, and a non-interactive shell will exit.
set -u

# Exit immediately if a command fails, also inside functions and subshells
# (-E makes the ERR trap inherited by them), and report what failed. Deliberate
# aborts go through die, which is not affected since it is always invoked
# behind || where errexit is suppressed.
set -eE
trap 'die "mkwp failed with exit code $? at line $LINENO: $BASH_COMMAND" $?' ERR

# The main script. Keep this as an ordinary function invocation: wrapping the
# call in a conditional (`main || ...`) would make Bash ignore `set -e` for all
# commands executed by the function.
main() {

	# Set options variables used by the script. Should another variable sneak into
	# the script, it's an error and `set -u` aborts the execution.
	name=
	title=
	directory=
	dirname=
	email=
	user=
	password=
	language=
	themes=
	plugins=
	mu_plugins=
	php=
	wp=
	redis=
	blueprint=
	no_blueprint=
	destroy=
	config=
	shift_n=

	# The configuration file that named the blueprint, if one did, as its
	# messages call it. See read_config_file.
	blueprint_named_in=

	# The blueprint's directory, which its relative paths are relative to,
	# and the outputs of read_blueprint_item.
	blueprint_dir=
	item_name=
	item_activate=

	# The themes, plugins and mu-plugins to install, in arrays that are used
	# by their names. See add_item.
	# shellcheck disable=SC2034
	themes_sources=() themes_kinds=() themes_pins=()
	# shellcheck disable=SC2034
	plugins_sources=() plugins_kinds=() plugins_pins=()
	# shellcheck disable=SC2034
	mu_plugins_sources=() mu_plugins_kinds=() mu_plugins_pins=()

	# The name of the theme to activate, and of the plugins to activate. The
	# last theme listed is activated if none is chosen and there is no
	# database.
	theme=
	last_theme=
	plugins_to_activate=()

	# The files and directories to copy, and the directories underneath
	# wp-content to copy them into, in arrays with the same indices.
	copy_sources=() copy_targets=()

	# The database dump to import or the DDEV snapshot to restore, if any, and
	# the database server to import or restore it into, if one is given. See
	# read_blueprint_database.
	database_dump=
	database_snapshot=
	database_server=

	# The WP-CLI commands to run at the end. See read_blueprint_wp_cli.
	wp_cli_args=()
	wp_cli_lengths=()

	# Parse the argument list from the command line
	handle_arguments "$@"

	# Normalize the site name, which doubles as DDEV project name and domain
	name=${name,,}

	# In destroy mode, tear down the site and exit; nothing below applies
	if [[ $destroy ]]; then
		destroy_site
	fi

	# --no-blueprint only makes sense without a blueprint on the command line
	[[ -z $no_blueprint || -z $blueprint ]] || die "--no-blueprint and -B/--blueprint can't be used together." 43

	# Read the configuration files, which may name the blueprint
	handle_config_files

	# Read the blueprint, if there is one. With --no-blueprint there is none,
	# even if a configuration file names one.
	if [[ $no_blueprint ]]; then
		blueprint=
	fi
	if [[ $blueprint ]]; then
		handle_blueprint
	fi

	# Note the site settings that were given, rather than filled in below,
	# since only those are applied over a database.
	title_given=$title
	language_given=$language

	# Tidy up, fill in default values and add some extra variables.
	title=${title:=${name^}}
	directory=${directory:=$(pwd)}
	dirname=${dirname:=$name}
	email=${email:=$(whoami)@$(hostname)}
	user=${user:=${email%@*}}
	password=${password:=$(LC_ALL=C tr -dc 'a-zA-Z0-9!#$%&()*+,-./:;<=>?@[\]_{|}' < /dev/urandom | head -c 16 || true)}
	language=${language:=en_US}
	php=${php:=8.5}
	wp_path="$directory/$dirname"
	url="https://$name.ddev.site"

	# Add the themes, plugins and mu-plugins given on the command line after
	# the blueprint's. The last theme given is activated, instead of the theme
	# the blueprint would have activated.
	if [[ $themes ]]; then
		theme=$(theme_to_activate "$themes")
	fi
	add_option_items themes "$themes"
	add_option_items plugins "$plugins"
	add_option_items mu_plugins "$mu_plugins"

	# Redis is used if -R is given or the blueprint sets it to true, and not if
	# the blueprint sets it to false
	if [[ $redis != true ]]; then
		redis=
	fi

	# Echo all parameters used by the script if debugging.
	if [[ $MKWP_DEBUG ]]; then
		echo "name=$name"
		echo "title=$title"
		echo "directory=$directory"
		echo "dirname=$dirname"
		echo "email=$email"
		echo "user=$user"
		echo "password=$password"
		echo "language=$language"
		echo "themes=$themes"
		echo "plugins=$plugins"
		echo "mu_plugins=$mu_plugins"
		echo "php=$php"
		echo "wp=$wp"
		echo "redis=$redis"
		echo "blueprint=$blueprint"
		echo "config=$config"
		echo "wp_path=$wp_path"
		echo "url=$url"
	fi

	# Validate options. Everything that doesn't need DDEV is checked before
	# DDEV and Docker are, so that a mistyped option is reported even when
	# Docker isn't running.
	[[ "$name" ]] || die "Error: Missing name of the project." 3
	[[ "$name" =~ ^[[:alpha:]]([[:alnum:]-]*[[:alnum:]])?$ ]] || die "Invalid name: $name. A DDEV project name must start with a letter and may otherwise only contain letters, digits and hyphens. Use -D/--dirname to name the site directory freely." 11
	[[ "$dirname" =~ ^[^/]+$ && "$dirname" != "." && "$dirname" != ".." ]] || die "Invalid dirname: $dirname" 20
	[[ "$title" =~ $title_pattern ]] || die "Invalid title: $title" 4
	[[ "$email" =~ ^[[:alnum:]._%+-]+@[[:alnum:].-]+\.[[:alpha:]]{2,}$ ]] || die "Invalid email address: $email" 6
	[[ $password =~ ^[[:print:]]{12,}$ ]] || die "Invalid password. Must be at least 12 characters." 7
	[[ "$language" =~ $language_pattern ]] || die "Invalid language code: $language" 8
	[[ "$php" =~ $php_pattern ]] || die "Invalid PHP version: $php" 9
	[[ -z "$wp" || "$wp" =~ $wp_pattern ]] || die "Invalid WordPress version: $wp" 17
	[[ ! -e "$wp_path/.ddev/config.yaml" ]] || die "A DDEV project already exists in the directory $wp_path." 15
	[[ ! -e "$wp_path" ]] || die "$wp_path already exists" 13
	[[ -d "$directory" && -w "$directory" ]] || die "Cannot create $wp_path" 14

	# Check that DDEV is working
	ddev debug dockercheck &> /dev/null || die "Error: Check that a Docker provider is installed and running and that DDEV is properly installed" 1

	# Validate the options that DDEV must be asked about
	ddev_projects=$(ddev list -j)
	if echo "$ddev_projects" | grep -q "\"approot\":\"$wp_path\""; then die "A DDEV project already exists in the directory $wp_path." 15; fi
	if echo "$ddev_projects" | grep -q "\"name\":\"$name\""; then die "A project named '$name' already exists in DDEV." 16; fi

	# Create and enter the WordPress root directory.
	mkdir -p "$wp_path"
	cd "$wp_path"

	# Configure the project before the first start, so that all customizations
	# below — PHP settings, host commands, cron and the optional Redis service
	# — are baked into the containers in a single start with no restart needed.
	ddev config --project-name="$name" --project-type=wordpress --disable-settings-management --php-version="$php" --performance-mode=mutagen ${database_server:+"--database=$database_server"}

	# Create local php.ini with infinite timeout. Don't use on production!
	mkdir -p .ddev/php
	cat <<- 'EOT' > .ddev/php/my-php.ini
	[PHP]
	; Don't do this in production :-p
	max_input_time = 0          ; infinite time
	max_execution_time = 0      ; infinite time
	default_socket_timeout = -1 ; infinite time
	EOT

	# Create host commands 'enter'
	mkdir -p .ddev/commands/host
	cat <<- 'EOT' > .ddev/commands/host/enter
	#!/usr/bin/env bash
	ddev ssh --dir="$(ddev exec pwd)/$(realpath --relative-to=$DDEV_APPROOT $(pwd))" "$@"
	EOT

	# Create host commands 'here'
	cat <<- 'EOT' > .ddev/commands/host/here
	#!/usr/bin/env bash
	ddev exec --dir="$(ddev exec pwd)/$(realpath --relative-to=$DDEV_APPROOT $(pwd))" "$@"
	EOT
	chmod +x .ddev/commands/host/enter .ddev/commands/host/here

	# Install the cron add-on and schedule WordPress cron to run every minute
	ddev add-on get ddev/ddev-cron
	cat <<- 'EOT' > .ddev/web-build/wp.cron
	* * * * * IS_DDEV_PROJECT=true /usr/local/bin/wp --path=/var/www/html cron event run --due-now > /dev/null 2>&1
	EOT

	# Add a Redis service to be used as WordPress object cache backend
	if [[ $redis ]]; then
		ddev add-on get ddev/ddev-redis
	fi

	# Start the Docker containers
	ddev start

	# Fail before installing WordPress if the requested Redis service is not
	# reachable. This also catches an incomplete or unhealthy add-on install.
	if [[ $redis ]]; then
		[[ "$(ddev redis-cli ping)" == "PONG" ]] || die "Redis was requested but the DDEV Redis service is not reachable." 26
	fi

	# Download WordPress without the default themes and plugins, which saves
	# both download and file synchronization time; themes to use are installed
	# further down. When a version is requested, derive the core auto-update
	# policy from how precisely it was given, resolve any omitted parts to the
	# highest available release, and download that exact version.
	if [[ "$wp" ]]; then
		case "$wp" in
			*.*.*) wp_auto_update=false ;;      # exact x.y.z: pin, no auto-updates
			*)     wp_auto_update="'minor'" ;;  # x or x.y: only patch (.z) auto-updates
		esac
		wp=$(resolve_wp_version "$wp") || exit $?
		echo "Installing WordPress $wp"
		ddev wp core download --version="$wp" --locale="$language" --skip-content
	else
		wp_auto_update="'minor'"
		ddev wp core download --locale="$language" --skip-content
	fi

	# Flush Mutagen so the downloaded files are visible on the host
	ddev mutagen sync

	# Create wp-config.php
	ddev wp config create --dbname=db --dbuser=db --dbpass=db --dbhost="ddev-$name-db" --dbprefix=wp_ --dbcharset=utf8mb4 --dbcollate=utf8mb4_unicode_ci --locale="$language" --extra-php <<- EOT
	define( 'WP_ENVIRONMENT_TYPE', 'local' );
	define( 'DISABLE_WP_CRON', true );
	define( 'WP_MEMORY_LIMIT', '128M' );
	define( 'WP_MAX_MEMORY_LIMIT', '256M' );
	define( 'DISALLOW_FILE_EDIT', true );
	define( 'WP_AUTO_UPDATE_CORE', ${wp_auto_update} );
	define( 'MEDIA_TRASH', true );
	define( 'EMPTY_TRASH_DAYS', 90 );
	define( 'WP_DEBUG', true );
	define( 'WP_DEBUG_LOG', true );
	define( 'WP_DEBUG_DISPLAY', false );
	EOT

	# Install WordPress
	ddev wp core install --url="$url" --title="$title" --admin_user="$user" --admin_password="$password" --admin_email="$email" --skip-email

	# Use pretty permalinks instead of the default plain ones
	ddev wp rewrite structure '/%postname%/'

	# Set the site timezone when one can be derived from the language
	timezone=$(timezone_from_locale "$language")
	if [[ $timezone ]]; then
		ddev wp option update timezone_string "$timezone"
	fi

	# If no theme is specified, default to WordPress's current default theme,
	# whose slug is declared among core's default constants. Without a
	# database, a theme is always activated: the theme chosen with -T or
	# "activate": true, else the last one listed, else the default theme. With
	# a database, only a chosen theme is activated, and the database's active
	# theme is otherwise kept.
	if (( ${#themes_sources[@]} == 0 )); then
		default_theme=$(sed -n "s/.*'WP_DEFAULT_THEME', '\([^']*\)'.*/\1/p" wp-includes/default-constants.php)
		[[ "$default_theme" ]] || die "Couldn't determine the default theme." 25
		add_item themes slug "$default_theme"
		last_theme=$default_theme
	fi
	if [[ -z $database_dump && -z $database_snapshot ]]; then
		theme=${theme:-$last_theme}
	fi

	# Create home for "must use" plugins
	mkdir -p wp-content/mu-plugins/DISABLED
	cp wp-content/index.php wp-content/mu-plugins

	# Install themes, plugins and mu-plugins
	install_items themes
	install_items plugins
	install_items mu_plugins

	# Copy the blueprint's files into wp-content
	if (( ${#copy_sources[@]} )); then
		copy_files
	fi

	# Import the dump or restore the snapshot, if there is one, and make the
	# database the site's own
	if [[ $database_dump ]]; then
		ddev import-db --file="$database_dump"
		adopt_database "$database_dump"
	elif [[ $database_snapshot ]]; then
		restore_snapshot
		adopt_database "$database_snapshot"
	fi

	# Activate the theme, if there is one to activate, and the plugins marked
	# for activation
	if [[ $theme ]]; then
		ddev wp theme activate "$theme"
	fi
	if (( ${#plugins_to_activate[@]} )); then
		ddev wp plugin activate "${plugins_to_activate[@]}"
	fi

	# Enable Redis as object cache backend: install and activate the Redis
	# Object Cache plugin, point it to DDEV's Redis service, and enable the
	# object-cache.php drop-in.
	if [[ $redis ]]; then
		ddev wp plugin install redis-cache --activate
		ddev wp config set WP_REDIS_HOST redis
		ddev wp redis enable
	fi

	# Run the WP-CLI commands from the blueprint, in order
	run_wp_cli_commands

	# Launch site
	ddev launch

	# Inform user.
	echo -e "\e[1;30;103m\n\nYou should now see your new WordPress site in your browser.\n\nUsername: $user\npassword: $password\n\e[0m"

}

main "$@"
